# Copy to .env. Every value below has a working default for the docker-compose
# Postgres, so `cp .env.example .env` is enough to get running.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Matches docker-compose.yml. Point this anywhere; nothing else needs to change.
DATABASE_URL=postgres://orders:orders@localhost:5433/orders_api

# HS256 secret for the demo tokens minted by `npm run token`.
# Development value. In production this comes from a secret manager, and the
# config loader refuses to boot on anything shorter than 32 characters.
JWT_SECRET=dev-only-secret-change-me-in-production-0000
JWT_ISSUER=orders-api
JWT_AUDIENCE=orders-api

# Connection budget per instance. See src/config/env.ts.
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=5000

ORDERS_DEFAULT_PAGE_SIZE=20
ORDERS_MAX_PAGE_SIZE=100

# Optional. Defaults to DATABASE_URL with "_test" appended to the database name.
# TEST_DATABASE_URL=postgres://orders:orders@localhost:5433/orders_api_test
